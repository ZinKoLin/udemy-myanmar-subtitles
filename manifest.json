{
  "manifest_version": 3,
  "name": "Udemy Burmese Subtitles",
  "version": "0.7.0",
  "minimum_chrome_version": "116",
  "description": "Learn with automatic Burmese subtitles for Udemy lectures.",
  "permissions": ["storage", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://gemini.google.com/*", "https://*.udemycdn.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://*.udemy.com/*", "https://udemy.com/*"],
    "js": ["core.js", "browser-core.js", "content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://gemini.google.com/*"],
    "js": ["gemini-browser.js"],
    "run_at": "document_idle"
  }]
}
